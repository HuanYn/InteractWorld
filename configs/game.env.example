# Local-only example. Copy values into your shell; never commit credentials.
IW_SESSION_ROOT=outputs/sessions
IW_LLM_BASE_URL=http://127.0.0.1:8874/v1
IW_LLM_MODEL=base-general
IW_WAN_BASE_URL=http://127.0.0.1:8878
# For real inference only: replace with assets you actually own.
# IW_LAB_INITIAL_IMAGE=/path/to/runtime/initial.png
# IW_ACTION_ROLLOUT=/path/to/assets/rollout.yaml
# IW_ASSET_ORIGINAL_ROOT=/actual/original/root/from/receipts
# IW_LLM_API_KEY=  (set privately if your provider requires it)
# The UI never starts cluster services; run providers under your own scheduler.
